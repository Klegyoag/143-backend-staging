{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "x10think/143-backend",
  "type": "project",
  "description": "143 mobile app backend - Laravel 13 API",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.17",
    "laravel/sanctum": "^4.3",
    "laravel/reverb": "^1.0",
    "predis/predis": "^3.0",
    "laravel/tinker": "^3.0",
    "league/flysystem-aws-s3-v3": "^3.0",
    "dompdf/dompdf": "^3.1"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.8",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\\\": "app/",
      "Database\\\\Factories\\\\": "database/factories/",
      "Database\\\\Seeders\\\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\\\Foundation\\\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php artisan migrate --graceful --ansi"
    ],
    "dev": [
      "Composer\\\\Config::disableProcessTimeout",
      "npx concurrently -c \\\"#93c5fd,#c4b5fd,#fb7185,#fdba74\\\" \\\"php artisan serve\\\" \\\"php artisan queue:listen --tries=1\\\" \\\"php artisan pail --timeout=0\\\" \\\"php artisan reverb:start --debug\\\" --names=server,queue,logs,reverb --kill-others"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
