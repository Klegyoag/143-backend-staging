APP_NAME="143 API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DATABASE_URL=postgresql://app143:app143@postgres:5432/app143
DB_SSLMODE=prefer
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=predis
REDIS_URL=redis://redis:6379

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=143
REVERB_APP_KEY=local-143-key
REVERB_APP_SECRET=local-143-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

UPLOAD_DISK=s3
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=143-private
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
COUPLE_INVITE_HOURS=72

OPENAI_API_KEY=
